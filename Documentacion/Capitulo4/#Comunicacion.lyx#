\begin_layout Enumerate
Pruebas de comunicación
\end_layout

\begin_deeper
\begin_layout Itemize
Suscriptor (en el BROKER / PC)
\end_layout

\begin_layout Standard
Escucha todos los tópicos que empiecen con Plc/:
\end_layout

\begin_layout Standard
\begin_inset listings
inline false
status open

\begin_layout Plain Layout

mosquitto_sub -h localhost -t "Plc/#" -u plcuser -P "plc" 
\end_layout

\end_inset


\end_layout

\begin_layout Itemize
Publicador (en el CLIENTE / PLC)
\end_layout

\begin_layout Standard
Envía un mensaje de prueba:
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "breaklines=true,showstringspaces=false"
inline false
status open

\begin_layout Plain Layout

mosquitto_pub -h <IP_DEL_BROKER> -t "Plc/Adc" -m "123" -u plcuser -P "plc"
 
\end_layout

\end_inset

Ejemplo: Si el PC tiene IP 192.168.1.100, entonces:
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "breaklines=true,showstringspaces=false"
inline false
status open

\begin_layout Plain Layout

