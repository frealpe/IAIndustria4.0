\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Phi}=\begin{bmatrix}-y(n) & -y(n-1) & \cdots & -y(1)\\
-y(n+1) & -y(n) & \cdots & -y(2)\\
\vdots & \vdots & \ddots & \vdots\\
-y(N-1) & -y(N-2) & \cdots & -y(N-n)
\end{bmatrix}\label{eq:matrizregresores}
\end{equation}

\end_inset


