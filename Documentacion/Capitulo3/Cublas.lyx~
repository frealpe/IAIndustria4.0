 que corresponde a orden del modelo y N que corresponde al número de muestra
 se define como.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathbf{y}=\begin{bmatrix}y(n+1)\\
y(n+2)\\
\vdots\\
y(N)
\end{bmatrix}\label{eq:vectorsalida}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Phi}=\begin{bmatrix}\varphi{}^{T}(n)\\
\varphi{}^{T}(n+1)\\
\vdots\\
\varphi{}^{T}(N-1))
\end{bmatrix}\label{eq:Matrizcruzada}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Es posible representar entonces de manera matricial 
\begin_inset CommandInset ref
