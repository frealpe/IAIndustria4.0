\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Phi^{T}\Phi=\begin{bmatrix}\sum_{k=3}^{N}y^{2}(k-1) & \sum_{k=3}^{N}y(k-1)y(k-2)\\
\sum_{k=3}^{N}y(k-2)y(k-1) & \sum_{k=3}^{N}y^{2}(k-2)
\end{bmatrix}\label{eq:equivalenteseriematriz}
\end{equation}

\end_inset


\end_layout

