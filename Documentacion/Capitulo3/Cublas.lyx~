reference "eq:phimatricial"
plural "false"
caps "false"
noprefix "false"

\end_inset

 queda como 
\begin_inset Formula $\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}=\left[\sum_{k=3}^{N}\varphi(k-1)\varphi^{T}(k-1)\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}=\begin{bmatrix}-y(2) & -y(3) & \cdots & -y(N-1)\\
-y(1) & -y(2) & \cdots & -y(N-2)
\end{bmatrix}\begin{bmatrix}-y(2) & -y(1)\\
-y(3) & -y(2)\\
\vdots & \vdots\\
-y(N-1) & -y(N-2)
\end{bmatrix}\label{eq:matricialcruzada}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Es fácil observar que la multiplicación de termino a termino de la expresión
 
\begin_inset CommandInset ref
