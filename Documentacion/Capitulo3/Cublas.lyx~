E=y-\hat{y}=y-\left(\boldsymbol{\Phi}\theta\right)\label{eq:errormatricial}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
La función de costo 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:funcion_costo"
plural "false"
caps "false"
noprefix "false"

\end_inset

 se puede escribir de manera matricial como:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
J(\theta)=\frac{1}{N}(y-\left(\boldsymbol{\Phi}\theta\right))^{T}(y-\left(\boldsymbol{\Phi}\theta\right))\label{eq:funcioncostomatricial}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Expandiendo
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
J=\frac{1}{N}\left(y^{T}y-2y^{T}\boldsymbol{\Phi}\theta+\theta^{T}\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}\theta\right)\label{eq:costoexpansion}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Derivado con respecto a 
\begin_inset Formula $\theta$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{\partial J}{\partial\theta}=-\frac{2}{N}\boldsymbol{\Phi}^{T}y+\frac{2}{N}\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}\theta\label{eq:derivadatheta}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Igualando a cero a 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:derivadatheta"
plural "false"
caps "false"
noprefix "false"

\end_inset

, condición del mínimo 
\begin_inset Formula $\frac{\partial J}{\partial\theta}=0$
\end_inset

 .
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}\theta=\boldsymbol{\Phi}^{T}y\label{eq:condiciondelminimo}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Organizando y despejando a 
\begin_inset Formula $\theta$
\end_inset

 de 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:condiciondelminimo"
plural "false"
caps "false"
noprefix "false"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\hat{\theta}=\left(\boldsymbol{\Phi}^{T}\boldsymbol{\Phi}\right)^{-1}\boldsymbol{\Phi}^{T}y\label{eq:phimatricial}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Ahora extendiendo a 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Matrizcruzada"
plural "false"
caps "false"
noprefix "false"

