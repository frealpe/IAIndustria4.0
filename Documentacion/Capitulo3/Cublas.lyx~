\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Phi}=\begin{bmatrix}-y(n) & -y(n-1)\\
-y(n+1) & -y(n)\\
\vdots & \vdots\\
-y(N-1) & -y(N-2)
\end{bmatrix}=\begin{bmatrix}-y(2) & -y(1)\\
-y(3) & -y(2)\\
\vdots & \vdots\\
