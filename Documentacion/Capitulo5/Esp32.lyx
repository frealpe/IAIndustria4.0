\end_layout

\begin_layout Plain Layout

data_dir = src/data
\end_layout

\begin_layout Plain Layout

;[common] (Sección de Herencia/Plantilla)
\end_layout

\begin_layout Plain Layout

;Esta no es una sección oficial de PlatformIO,
\end_layout

\begin_layout Plain Layout

;sino una convención que usamos los desarrolladores para no repetir código.
\end_layout

\begin_layout Plain Layout

;Para qué sirve: Es como una "bolsa" donde guardas configuraciones que quieres
 usar en múltiples placas.
\end_layout

\begin_layout Plain Layout

;Por ejemplo, si tienes 5 modelos de ESP32 diferentes, defines la versión
 o las librerías
\end_layout

\begin_layout Plain Layout

;aquí una sola vez y luego las "llamas" desde los otros entornos usando
 ${common.nombre_de_variable}.
\end_layout

\begin_layout Plain Layout

;Dato curioso: Puedes llamarla [common], [config] o como quieras, mientras
 luego la referencies correctamente.
\end_layout

\begin_layout Plain Layout

[common] 
\end_layout

\begin_layout Plain Layout

;version: bandera de preprocesador que se añade a la compilación (ej.
 para identificar builds) 
\end_layout

\begin_layout Plain Layout

version = -D BUILD_TAG=V1.0.a0-Build-20260202 
\end_layout

\begin_layout Plain Layout

;lib_deps: dependencias comunes de librerías (vacío si no hay dependencias
 compartidas) 
\end_layout

\begin_layout Plain Layout

lib_deps =
\end_layout

\begin_layout Plain Layout

;[env:nombre_del_entorno] (Configuración del Entorno) 
\end_layout

\begin_layout Plain Layout

;Esta es la sección más importante.
 Cada bloque que empiece con env: define una tarea de compilación específica.
\end_layout

\begin_layout Plain Layout

;Para qué sirve: Aquí especificas los "fierros" (el hardware).
\end_layout

\begin_layout Plain Layout

;Le dices a PlatformIO: "Para este entorno llamado 'esp32dev',
\end_layout

\begin_layout Plain Layout

;usa estas librerías, esta velocidad de subida y este framework".
 
\end_layout

\begin_layout Plain Layout

;Multi-entorno: Puedes tener varios.
 Por ejemplo: ;[env:debug] (para pruebas lentas con muchos mensajes).
 
\end_layout

\begin_layout Plain Layout

;[env:release] (para la versión final optimizada).
\end_layout

\begin_layout Plain Layout

[env:esp32dev] 
\end_layout

\begin_layout Plain Layout

;platform: plataforma de desarrollo (núcleo y toolchain), aquí Espressif32
 para ESP32 
\end_layout

\begin_layout Plain Layout

platform = espressif32 
\end_layout

\begin_layout Plain Layout

;framework: framework usado por el proyecto (Arduino en este caso) 
\end_layout

\begin_layout Plain Layout

framework = arduino 
\end_layout

\begin_layout Plain Layout

;board: placa objetivo definida por PlatformIO (define pines, flash, etc.)
 
\end_layout

\begin_layout Plain Layout

board = esp32dev 
\end_layout

\begin_layout Plain Layout

;board_build.mcu: identificador del microcontrolador (opcional, usado para
 algunos ajustes) 
\end_layout

\begin_layout Plain Layout

board_build.mcu = esp32 
\end_layout

\begin_layout Plain Layout

;board_build.partitions: 
\end_layout

\begin_layout Plain Layout

ruta a una tabla de particiones personalizada (vacía = usar la por defecto)
 
\end_layout

\begin_layout Plain Layout

board_build.partitions = default_ota.csv
\end_layout

\begin_layout Plain Layout

;upload_protocol: protocolo/utilidad que se usa para subir el firmware (esptool
 es común en ESP32) 
\end_layout

\begin_layout Plain Layout

upload_protocol = esptool
\end_layout

\begin_layout Plain Layout

;lib_deps: dependencias de librerías específicas de este entorno; aquí se
 incluye lo común 
\end_layout

\begin_layout Plain Layout

lib_deps =     
\end_layout

\begin_layout Plain Layout

	${common.lib_deps}
\end_layout

\begin_layout Plain Layout

; src_build_flags: flags de compilación/definiciones para el código fuente
 (usa la variable common.version) 
\end_layout

\begin_layout Plain Layout

src_build_flags = ${common.version}
\end_layout

\begin_layout Plain Layout

;upload_speed: baudrate usado por la herramienta de subida (esptool) 
\end_layout

\begin_layout Plain Layout

upload_speed = 921600 
\end_layout

\begin_layout Plain Layout

;monitor_speed: baudrate para el monitor serie
\end_layout

\begin_layout Plain Layout

monitor_speed = 115200 
\end_layout

\begin_layout Plain Layout

;upload_port: puerto serie a usar para subir el firmware.
\end_layout

\begin_layout Plain Layout

;Si se deja comentado, PlatformIO intentará autodetectar el puerto.
 
\end_layout

\begin_layout Plain Layout

;upload_port = /dev/ttyUSB0
\end_layout

\begin_layout Plain Layout

;monitor_port: puerto a usar para el monitor serie (comentado para autodetección
)
\end_layout

\begin_layout Plain Layout

;monitor_port = /dev/ttyUSB0 
\end_layout

