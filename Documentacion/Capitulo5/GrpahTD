config:
  layout: elk
---
graph TD
    subgraph settingsRead ["settingsRead()"]
        StartRead([Inicio Lectura]) --> CreateJSONRead["Crear JSON Document"]
        CreateJSONRead --> OpenFileRead["Abrir /settings.json (Lectura)"]
        OpenFileRead --> CheckDeserialize{"¿Error al Deserializar?"}
        
        CheckDeserialize -- Sí --> CallReset["Llamar settingsReset()"]
        CallReset --> ReadError["Leer Error de Deserialización"]
        ReadError --> LogReadError["Log: Error lectura, valores por defecto"]
        LogReadError --> CheckErrorDetails{"¿Detalles del Error?"}
        CheckErrorDetails -- Sí --> LogDetails["Log: Detalle del error"]
        CheckErrorDetails -- No --> ReturnFalseRead([Retornar false])
        LogDetails --> ReturnFalseRead
        
        CheckDeserialize -- No --> ReadDevice["Leer Configuración Dispositivo"]
        ReadDevice --> ReadWifiClient["Leer Configuración WiFi Cliente"]
        ReadWifiClient --> ReadWifiAP["Leer Configuración WiFi AP"]
        ReadWifiAP --> ReadCloud["Leer Configuración Cloud MQTT"]
        ReadCloud --> CloseFileRead["Cerrar Archivo"]
        CloseFileRead --> LogSuccessRead["Log: Lectura correcta"]
        LogSuccessRead --> ReturnTrueRead([Retornar true])
    end

    subgraph settingsReset ["settingsReset()"]
        StartReset([Inicio Reset]) --> SetDeviceDefaults["Asignar valores por defecto Dispositivo"]
        SetDeviceDefaults --> SetWifiClientDefaults["Asignar valores por defecto WiFi Cliente"]
        SetWifiClientDefaults --> SetWifiAPDefaults["Asignar valores por defecto WiFi AP"]
        SetWifiAPDefaults --> SetCloudDefaults["Asignar valores por defecto Cloud MQTT"]
        SetCloudDefaults --> LogReset["Log: Valores por defecto reiniciados"]
    end

    subgraph settingsSave ["settingsSave()"]
        StartSave([Inicio Guardado]) --> CreateJSONSave["Crear JSON Document"]
        CreateJSONSave --> OpenFileWrite["Abrir /settings.json (Escritura)"]
        
        OpenFileWrite --> CheckFileWrite{"¿Archivo Abierto?"}
        
        CheckFileWrite -- Sí --> SaveDevice["Guardar Configuración Dispositivo en JSON"]
        SaveDevice --> SaveWifiClient["Guardar Configuración WiFi Cliente en JSON"]
        SaveWifiClient --> SaveWifiAP["Guardar Configuración WiFi AP en JSON"]
        SaveWifiAP --> SaveCloud["Guardar Configuración Cloud MQTT en JSON"]
        SaveCloud --> SerializeFile["Serializar JSON a Archivo"]
        SerializeFile --> CloseFileWrite["Cerrar Archivo"]
        CloseFileWrite --> LogSuccessSave["Log: Guardado correcto"]
        LogSuccessSave --> SerializeSerial["Serializar JSON al Serial"]
        SerializeSerial --> ReturnTrueSave([Retornar true])
        
        CheckFileWrite -- No --> LogSaveError["Log: Falló guardado"]
        LogSaveError --> ReturnFalseSave([Retornar false])
    end

