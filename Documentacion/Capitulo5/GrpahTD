graph TD
    Start([1. Inicio: main.cpp]) -->|xTaskCreate| Task[2. Tarea: TaskMqttReconnect]
    
    subgraph "Ciclo Infinito (FreeRTOS)"
        Task -->|Verificar WiFi| WifiCheck{¿WiFi OK?}
        WifiCheck -- No --> Esperar[Esperar]
        WifiCheck -- Si --> Function[3. Llamada: mqttloop]
        WifiCheck -- Si --> Timer{¿Intervalo Cumplido?}
    end

    subgraph "Lógica MQTT (mcp_mqtt.hpp)"
        Function --> Connected{¿Conectado al Broker?}
        
        Connected -- No --> Connect[mqtt_connect]
        Connect -->|Usuario/Pass| Broker((MQTT Broker))
        Connect -->|Subscribe| Topic[Suscripción: 'Plc/Esp32']
        
        Connected -- Si --> Loop[client.loop]
        Loop -->|Escuchar Red| Broker
    end

    subgraph "Lectura de Sensores (Periódico)"
        Timer -- Si --> Pub[4. Función: mqtt_publish]
        Pub --> JsonFn[Función: Json]
        JsonFn --> Read[5. Función: readSensor]
        
        Read -->|analogRead| ADC(GPIO: ADC_PIN)
        JsonFn --> Send[Publicar Estado JSON]
        Send --> Broker
    end

    subgraph "Procesamiento de Mensaje (Entrada)"
        Broker -->|Nuevo Mensaje JSON| Callback[6. Evento: callback]
        Callback -->|deserializeJson| Parser{¿Tipo de Comando?}
        
        Parser -- 'RELAYS' --> FuncRelay[7. Función: apiPostOnOffRelays]
        Parser -- 'DIMMER' --> FuncDim[Función: apiPostDimmer]
        Parser -- 'RESTART' --> FuncRest[Función: apiPostRestart]
    end

    subgraph "Acción Física (Hardware)"
        FuncRelay -->|digitalWrite| PinRelay(GPIO 32/33: Relay ON/OFF)
        FuncDim -->|ledcWrite| PinPWM(GPIO 25: Dimmer PWM)
    end
    
    FuncRelay --> Save[Guardar Estado en SPIFFS]
    FuncRelay --> Reply[Responder al Broker 'Hecho']
